# Copy this file to .env (or export these directly in your shell) to enable --email.
# CAMPING_ALERT_APP_PASSWORD is a Gmail "App Password", not your regular Gmail
# password - create one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be enabled on the account).

CAMPING_ALERT_EMAIL=you@gmail.com
CAMPING_ALERT_APP_PASSWORD=xxxxxxxxxxxxxxxx
